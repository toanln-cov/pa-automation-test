__pycache__/
*.pyc
.venv/
venv/
*.log
.DS_Store
.idea/
.vscode/
*.swp
~$*

# workstation settings: local only
CLAUDE.local.md
.claude/


# secrets: tokens, keys, certificates
*token*.txt
*.pem
*.key
